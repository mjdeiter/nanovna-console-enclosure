;TYPE:Custom
G90 ; absolute positioning
M83 ; relative extruder
M400
M220 S100
M221 S100
SET_GCODE_OFFSET Z=-3.150 MOVE=0 ; calibrated nozzle-to-bed offset (CAL1 sweep 2026-10-15) - touchscreen sets -3.2 but Fluidd and API starts set none
M104 S140 ; keep nozzle cool while homing (nozzle-contact probe)
M190 S80 ; wait for bed before homing, as Elegoo's profile does
G28 ; home all axes
BED_MESH_PROFILE LOAD=6 ; mesh saved by the printer's auto-leveling
M109 S245 ; wait for nozzle
G92 E0
G1 Z2 F600
G1 X10 Y5 F6000
G1 Z0.3 F600
G1 X110 Y5 E10 F1200 ; purge line
G1 X110 Y5.8 F1200
G1 X10 Y5.8 E10 F1200
G1 Z2 F600
G92 E0
G21 ; set units to millimeters
G90 ; use absolute coordinates
M83 ; use relative distances for extrusion
; Filament gcode
M107
